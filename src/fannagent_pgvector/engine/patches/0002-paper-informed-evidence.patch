+static void
+TraceLine(const char *line)
+{
+	Size length;
+
+	if (executionState.traceFile == NULL || executionState.traceTruncated)
+		return;
+	length = strlen(line);
+	if (executionState.traceBytes >= executionState.traceMaxBytes ||
+		length >= (Size) (executionState.traceMaxBytes - executionState.traceBytes))
+	{
+		executionState.traceTruncated = true;
+		return;
+	}
+	if (fwrite(line, 1, length, executionState.traceFile) != length ||
+		fputc('\n', executionState.traceFile) == EOF)
+	{
+		executionState.traceTruncated = true;
+		return;
+	}
+	executionState.traceBytes += length + 1;
+}
